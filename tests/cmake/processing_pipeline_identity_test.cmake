cmake_minimum_required(VERSION 3.25)
include("${SOURCE_ROOT}/cmake/ProcessingPipelineIdentity.cmake")
set(CMAKE_CXX_COMPILER_ID GNU)
set(CMAKE_CXX_COMPILER_VERSION 15.2.0)
set(CMAKE_BUILD_TYPE Release)
set(CMAKE_CXX_FLAGS "-fno-fast-math")
set(CMAKE_CXX_FLAGS_RELEASE "-O3 -DNDEBUG")
if(AUDIT_CHILD)
  rifelove_generate_processing_identity("${FIXTURE_ROOT}" "${TEST_OUTPUT_ROOT}/audit-child")
  return()
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(root "${TEST_OUTPUT_ROOT}/processing-identity-${nonce}")
set(fixture "${root}/sources")
foreach(relative IN LISTS rifelove_processing_identity_sources)
  get_filename_component(parent "${fixture}/${relative}" DIRECTORY)
  file(MAKE_DIRECTORY "${parent}")
  file(WRITE "${fixture}/${relative}" "fixture source: ${relative}\n")
endforeach()
file(COPY_FILE "${SOURCE_ROOT}/cmake/processing_pipeline_identity.hpp.in" "${fixture}/cmake/processing_pipeline_identity.hpp.in")
rifelove_generate_processing_identity("${fixture}" "${root}/first")
rifelove_generate_processing_identity("${fixture}" "${root}/same")
file(READ "${root}/first/processing_pipeline_identity.json" first)
file(READ "${root}/same/processing_pipeline_identity.json" same)
if(NOT first STREQUAL same)
  message(FATAL_ERROR "Same sources/build did not reproduce the identity")
endif()
foreach(relative IN ITEMS src/media/rife_color.cpp src/timeline/timeline.hpp src/restoration/temporal_window.cpp)
  file(APPEND "${fixture}/${relative}" "changed output-affecting code\n")
  rifelove_generate_processing_identity("${fixture}" "${root}/changed")
  file(READ "${root}/changed/processing_pipeline_identity.json" changed)
  string(JSON old_digest GET "${first}" sourceSha256)
  string(JSON new_digest GET "${changed}" sourceSha256)
  string(JSON old_writer GET "${first}" sourceFiles src/media/video_writer.cpp)
  string(JSON new_writer GET "${changed}" sourceFiles src/media/video_writer.cpp)
  if(old_digest STREQUAL new_digest OR NOT old_writer STREQUAL new_writer)
    message(FATAL_ERROR "Pipeline/header change did not independently change its identity: ${relative}")
  endif()
endforeach()
set(CMAKE_CXX_FLAGS "-ffast-math")
rifelove_generate_processing_identity("${fixture}" "${root}/flags")
file(READ "${root}/flags/processing_pipeline_identity.json" flags)
string(JSON old_flags GET "${changed}" build cxxFlagsSha256)
string(JSON new_flags GET "${flags}" build cxxFlagsSha256)
if(old_flags STREQUAL new_flags)
  message(FATAL_ERROR "Changed compiler flags were not bound")
endif()
file(WRITE "${fixture}/src/unreviewed_pipeline.hpp" "must require explicit review\n")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_ROOT=${SOURCE_ROOT}" "-DFIXTURE_ROOT=${fixture}"
  "-DTEST_OUTPUT_ROOT=${root}" -DAUDIT_CHILD=ON -P "${CMAKE_CURRENT_LIST_FILE}"
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(status EQUAL 0 OR NOT "${output}${error}" MATCHES "Unreviewed processing identity source")
  message(FATAL_ERROR "Unreviewed source addition was not rejected: ${output}${error}")
endif()
message(STATUS "Processing identity generation: deterministic, source/header-sensitive, compiler-sensitive and omission-guarded. Fixtures retained: ${root}")
