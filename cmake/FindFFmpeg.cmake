# Find only the explicitly selected local SDK. Cached results belong to that
# SDK, not merely to a library basename shared by multiple FFmpeg builds.
if(NOT RIFELOVE_FFMPEG_ROOT OR NOT IS_DIRECTORY "${RIFELOVE_FFMPEG_ROOT}")
  message(FATAL_ERROR "RIFELOVE_FFMPEG_ROOT must name an existing explicit FFmpeg SDK directory")
endif()
file(REAL_PATH "${RIFELOVE_FFMPEG_ROOT}" _rifelove_ffmpeg_root)
file(TO_CMAKE_PATH "${_rifelove_ffmpeg_root}" _rifelove_ffmpeg_root)
set(_rifelove_ffmpeg_components avformat avcodec avutil swscale)
set(_rifelove_ffmpeg_variables FFmpeg_INCLUDE_DIR)
foreach(component IN LISTS _rifelove_ffmpeg_components)
  list(APPEND _rifelove_ffmpeg_variables FFmpeg_${component}_LIBRARY)
endforeach()

# On a managed root switch clear only values previously discovered by this
# module. Foreign explicit overrides are errors, never hidden fallbacks.
if(DEFINED _RIFELOVE_FFMPEG_DISCOVERED_ROOT AND
   NOT _RIFELOVE_FFMPEG_DISCOVERED_ROOT STREQUAL _rifelove_ffmpeg_root)
  foreach(variable IN LISTS _rifelove_ffmpeg_variables)
    if(DEFINED ${variable} AND DEFINED _RIFELOVE_MANAGED_${variable} AND
       "${${variable}}" STREQUAL "${_RIFELOVE_MANAGED_${variable}}")
      unset(${variable} CACHE)
      unset(${variable})
    endif()
  endforeach()
endif()

function(_rifelove_assert_ffmpeg_path variable subdirectory)
  if(NOT DEFINED ${variable} OR NOT ${variable} OR "${${variable}}" MATCHES "-NOTFOUND$")
    return()
  endif()
  if(NOT EXISTS "${${variable}}")
    message(FATAL_ERROR "${variable} does not exist: ${${variable}}; clear FFmpeg_* cache entries and reconfigure the selected SDK")
  endif()
  file(REAL_PATH "${${variable}}" actual)
  file(REAL_PATH "${_rifelove_ffmpeg_root}/${subdirectory}" expected)
  file(TO_CMAKE_PATH "${actual}" actual)
  file(TO_CMAKE_PATH "${expected}" expected)
  if(WIN32)
    string(TOLOWER "${actual}" actual)
    string(TOLOWER "${expected}" expected)
  endif()
  if(subdirectory STREQUAL "include")
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "Mixed FFmpeg SDK: ${variable} is outside selected SDK include directory; clear FFmpeg_* cache entries and reconfigure")
    endif()
    if(NOT EXISTS "${${variable}}/libavformat/avformat.h")
      message(FATAL_ERROR "${variable} lacks libavformat/avformat.h in the selected SDK")
    endif()
  else()
    get_filename_component(parent "${actual}" DIRECTORY)
    if(NOT parent STREQUAL expected)
      message(FATAL_ERROR "Mixed FFmpeg SDK: ${variable} is outside selected SDK lib directory; clear FFmpeg_* cache entries and reconfigure")
    endif()
  endif()
endfunction()

_rifelove_assert_ffmpeg_path(FFmpeg_INCLUDE_DIR include)
foreach(component IN LISTS _rifelove_ffmpeg_components)
  _rifelove_assert_ffmpeg_path(FFmpeg_${component}_LIBRARY lib)
endforeach()
find_path(FFmpeg_INCLUDE_DIR libavformat/avformat.h PATHS "${_rifelove_ffmpeg_root}/include" NO_DEFAULT_PATH)
foreach(component IN LISTS _rifelove_ffmpeg_components)
  find_library(FFmpeg_${component}_LIBRARY NAMES ${component} PATHS "${_rifelove_ffmpeg_root}/lib" NO_DEFAULT_PATH)
endforeach()
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(FFmpeg REQUIRED_VARS FFmpeg_INCLUDE_DIR FFmpeg_avformat_LIBRARY FFmpeg_avcodec_LIBRARY FFmpeg_avutil_LIBRARY FFmpeg_swscale_LIBRARY)
if(FFmpeg_FOUND)
  _rifelove_assert_ffmpeg_path(FFmpeg_INCLUDE_DIR include)
  foreach(component IN LISTS _rifelove_ffmpeg_components)
    _rifelove_assert_ffmpeg_path(FFmpeg_${component}_LIBRARY lib)
    if(NOT TARGET FFmpeg::${component})
      add_library(FFmpeg::${component} UNKNOWN IMPORTED)
    endif()
    set_target_properties(FFmpeg::${component} PROPERTIES
      IMPORTED_LOCATION "${FFmpeg_${component}_LIBRARY}"
      INTERFACE_INCLUDE_DIRECTORIES "${FFmpeg_INCLUDE_DIR}")
  endforeach()
  set(_RIFELOVE_FFMPEG_DISCOVERED_ROOT "${_rifelove_ffmpeg_root}" CACHE INTERNAL "SDK owning cached FFmpeg discovery" FORCE)
  foreach(variable IN LISTS _rifelove_ffmpeg_variables)
    set(_RIFELOVE_MANAGED_${variable} "${${variable}}" CACHE INTERNAL "Last managed FFmpeg result" FORCE)
  endforeach()
endif()
